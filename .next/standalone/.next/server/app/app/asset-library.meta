{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/app/layout,_N_T_/app/asset-library/layout,_N_T_/app/asset-library/page,_N_T_/app/asset-library"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/app/asset-library/__PAGE__",
    "/app/asset-library",
    "/app",
    "/_index",
    "/_head"
  ]
}