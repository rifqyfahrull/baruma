# Contoh env Baruma — SEMUA variabel yang dibaca app + scripts (hasil grep
# `process.env` di src/, scripts/, .github/workflows/deploy.yml). Nilai di
# sini adalah PLACEHOLDER, bukan secret asli — aman ter-commit (lihat
# .gitignore: `.env*` di-ignore TAPI file ini di-whitelist via `!.env.example`).
#
# Rotasi kredensial produksi: docs/runbook-rotasi-kredensial.md
# Deploy/CI-only secrets (GH_TOKEN, DEPLOY_HOST, DEPLOY_SSH_KEY, DEPLOY_USER)
# TIDAK ada di sini — itu disimpan sebagai GitHub Actions secret, bukan
# ditulis ke .env.local (lihat .github/workflows/deploy.yml).

# ============================================================
# Inti aplikasi Next.js
# ============================================================
NODE_ENV=development
# URL publik app ini (dipakai untuk redirect checkout, webhook self-report, dst).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Fallback server-side untuk NEXT_PUBLIC_APP_URL bila diperlukan (checkout route).
APP_URL=http://localhost:3000
# Sumber data client: "mock" (in-memory, tanpa backend) atau "http" (API sungguhan).
# PRODUKSI WAJIB "http" — env-check.ts (instrumentation.ts) crash keras bila "mock".
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
API_URL=http://localhost:3000/api/v1
# SHA commit yang sedang berjalan — diisi otomatis oleh deploy.yml
# (`git rev-parse --short HEAD`), dipakai GET /api/health untuk field "version".
GIT_SHA=dev

# ============================================================
# Autentikasi lokal (JWT) + sesi
# ============================================================
# Kunci HMAC penandatanganan JWT auth lokal (src/lib/server/auth-server.ts).
# BOCOR = penyerang bisa memalsukan JWT siapa pun. Wajib string acak panjang.
BARUMA_JWT_SECRET=ganti-dengan-string-acak-panjang-openssl-rand-base64-48
# Kunci sesi NextAuth-style.
AUTH_SECRET=ganti-dengan-string-acak-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Daftar email admin (dipisah koma) — akses /api/v1/admin/*.
ADMIN_EMAILS=admin@example.com

# ============================================================
# Supabase SSO (bersama dengan tampil.dev, opsional — kosong = nonaktif)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# WAJIB NEXT_PUBLIC_ karena dibaca client Supabase browser untuk scope cookie.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=.tampil.dev
NEXT_PUBLIC_SSO_ORIGIN=https://tampil.dev
# Cloudflare Turnstile — captcha login/register/recovery (harus pasangan
# dengan secret Turnstile yang dikonfigurasi di Supabase).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ============================================================
# Database
# ============================================================
# Koneksi Postgres utama (src/lib/server/db.ts). Kosong di dev = beberapa
# repo jatuh ke memory-fallback (lihat src/lib/server/memory-fallback.ts) —
# PRODUKSI WAJIB terisi, env-check.ts crash keras bila kosong.
DATABASE_URL=postgres://user:password@localhost:5432/baruma

# ============================================================
# Object storage S3-compatible (upload aset GLB/tekstur, backup DB)
# ============================================================
# Kosong = fitur upload/backup nonaktif (storageEnabled() false) — bukan fatal
# di luar produksi.
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_REGION=auto
# URL publik bucket/CDN (opsional) — kosong = aset diserve lewat proxy
# same-origin /api/v1/assets/file/<key> (bucket boleh tetap privat).
STORAGE_PUBLIC_URL=

# ============================================================
# Billing — delegasi penuh ke parent tampil.dev (Baruma tak pernah pegang
# kredensial Mayar/Stripe langsung; Baruma = CHILD app)
# ============================================================
PARENT_BILLING_URL=https://tampil.dev
# Kosong = checkout/webhook nonaktif (payment_not_configured). HARUS SAMA
# dengan CHILD_BILLING_SECRET di sisi parent.
PARENT_BILLING_SECRET=
PARENT_BILLING_APP=baruma

# ============================================================
# Agent Lab (satu-satunya otoritas eksekusi/konfigurasi LLM — Baruma tak
# pernah memanggil provider model langsung)
# ============================================================
AGENT_LAB_URL=https://agentlab.tampil.dev
# Kosong = jalur berbasis model nonaktif, fallback deterministik tetap jalan.
AGENT_LAB_KEY=
# Kunci KHUSUS per-agent (bukan satu kunci produk-wide) untuk agent
# baruma-floorplan-actions — lihat SLUG_KEY_ENV map di src/lib/server/agent-lab.ts.
AGENT_LAB_KEY_FLOORPLAN_ACTIONS=

# ============================================================
# Observability — Sentry (opsional, sepenuhnya no-op bila kosong)
# ============================================================
# Server + edge (instrumentation.ts).
SENTRY_DSN=
# Browser (instrumentation-client.ts) — WAJIB NEXT_PUBLIC_ agar ter-inline ke bundle client.
NEXT_PUBLIC_SENTRY_DSN=

# ============================================================
# Email transaksional — Resend (WS-B, opsional, no-op sepenuhnya bila kosong;
# lihat src/lib/server/email.ts). Kosong = welcome/kuitansi/reminder/expired
# email tidak terkirim (bukan error, register/webhook/cron tetap jalan).
# ============================================================
RESEND_API_KEY=
# Format "Nama <alamat@domain>" atau alamat polos — dipakai apa adanya sebagai
# header From Resend.
EMAIL_FROM=

# ============================================================
# Cron maintenance harian (WS-B) — POST /api/internal/maintenance (expiry
# sweep + renewal reminder). Kosong = endpoint menolak SEMUA request (fail
# closed, beda dari email di atas yang fail-open-ke-no-op).
# ============================================================
MAINTENANCE_SECRET=

# ============================================================
# Analytics — Umami (WS-E, opsional, sepenuhnya no-op bila kosong; lihat
# src/components/analytics/umami-script.tsx). Kosong = tidak ada script
# analytics dimuat sama sekali (dataLayer push tetap jalan sebagai fallback).
# ============================================================
# URL script Umami (host cloud gratis: https://cloud.umami.is/script.js,
# atau self-host). WAJIB NEXT_PUBLIC_ karena dibaca browser.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ============================================================
# Halaman Bantuan (WS-E) — alamat kontak support ditampilkan & dipakai
# sebagai mailto: link. Placeholder sampai email support resmi ditetapkan.
# ============================================================
NEXT_PUBLIC_SUPPORT_EMAIL=support@baruma.id

# ============================================================
# Feature flags eksterior (rollout roadmap §21) — pola dinamis, lihat
# src/lib/features.ts: untuk tiap flag di EXTERIOR_FEATURE_FLAGS, baca
# FEATURE_<NAMA_FLAG> ("false" = matikan total) dan FEATURE_<NAMA_FLAG>_ROLLOUT
# (0-100, persentase rollout bertahap berbasis hash projectId+flag).
# Contoh nyata (lihat test capabilities/route.test.ts):
# ============================================================
FEATURE_PRESENTATION_MODE_V1=
FEATURE_ROOF_ZONES_V1_ROLLOUT=

# ============================================================
# E2E test only (Playwright) — TIDAK dipakai app runtime produksi
# ============================================================
E2E_PROJECT_ID=
RUN_E2E_PROD=

# ============================================================
# Faucet-check (diagnostik AI internal, dibatasi allowlist domain resmi)
# ============================================================
FAUCET_TEST_API_KEY=
FAUCET_TEST_BASE_URL=
FAUCET_TEST_MODEL=

# ============================================================
# Scripts/tooling offline (BUKAN runtime app produksi — hanya dipakai
# menjalankan skrip di scripts/ secara manual/lokal)
# ============================================================
# scripts/exec-sql.mjs dan sejenisnya — alias generik untuk DATABASE_URL.
DB_URL=
# scripts/asset-harvest/* — pipeline riset & klasifikasi katalog aset (offline).
FAUCET_API_KEY=
FAUCET_BASE_URL=
FAUCET_MODEL=
FAUCET_TOKENS=
FAUCET_TOKENS_FILE=
HARVEST_DIR=
HARVEST_CLASSIFY_SOURCE=
HARVEST_LLM_CONCURRENCY=
HARVEST_RELEVANT_ONLY=
MIN_RECALL3=
MODE=
# scripts/growth-foundry/* — riset pasar & benchmark model (offline, terpisah dari Agent Lab).
GROWTH_TASK=
GROWTH_TASK_LIMIT=
GROWTH_TRIES=
GROWTH_MODELS=
GROWTH_MAX_TOKENS=
GROWTH_WORD_LIMIT=
GROWTH_OUTPUT_SUFFIX=
# scripts/import-asset-library-projects.mjs — impor batch aset 3D dari sumber lokal.
ASSET_PIPELINE_DB_URL=
BARUMA_ASSET_BANK_ROOT=
BARUMA_BLENDER_SKP_ROOT=
BARUMA_BUILDING_GLB_DIR=
BARUMA_GALLERY_GLB_DIR=
BARUMA_IMPORT_USER_EMAIL=
BARUMA_IMPORT_USER_ID=
BARUMA_SKP_BATCH_CONVERTER=
BLENDER_EXE=
# RustFS CLI — dipakai import-asset-library-projects.mjs sebagai ALIAS lama
# untuk kredensial storage (lihat juga STORAGE_ACCESS_KEY/STORAGE_SECRET_KEY
# di bawah — beberapa skrip lama menerima nama non-_ID/_ACCESS ini juga).
RUSTFS_ENDPOINT=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=
RUSTFS_CLI_DIR=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# scripts/integration-test-agent.mjs — target URL uji integrasi agent lokal/staging.
BARUMA_URL=http://localhost:3000
